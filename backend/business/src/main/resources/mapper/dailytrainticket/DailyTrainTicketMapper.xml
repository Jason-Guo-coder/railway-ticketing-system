<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gjq.train.business.dailytrainticket.mapper.DailyTrainTicketMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.gjq.train.business.dailytrainticket.entity.DailyTrainTicket">
        <id column="id" property="id" />
        <result column="date" property="date" />
        <result column="train_code" property="trainCode" />
        <result column="start" property="start" />
        <result column="start_pinyin" property="startPinyin" />
        <result column="start_time" property="startTime" />
        <result column="start_index" property="startIndex" />
        <result column="end" property="end" />
        <result column="end_pinyin" property="endPinyin" />
        <result column="end_time" property="endTime" />
        <result column="end_index" property="endIndex" />
        <result column="ydz" property="ydz" />
        <result column="ydz_price" property="ydzPrice" />
        <result column="edz" property="edz" />
        <result column="edz_price" property="edzPrice" />
        <result column="rw" property="rw" />
        <result column="rw_price" property="rwPrice" />
        <result column="yw" property="yw" />
        <result column="yw_price" property="ywPrice" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, `date`, train_code, `start`, start_pinyin, start_time, start_index, `end`, end_pinyin, end_time, end_index, ydz, ydz_price, edz, edz_price, rw, rw_price, yw, yw_price, create_time, update_time
    </sql>

    <update id="deductInventory">
        update daily_train_ticket
        set ydz = ydz - #{ydz},
            edz = edz - #{edz},
            rw = rw - #{rw},
            yw = yw - #{yw},
            update_time = now(3)
        where id = #{id}
          and ydz &gt;= #{ydz}
          and edz &gt;= #{edz}
          and rw &gt;= #{rw}
          and yw &gt;= #{yw}
    </update>

</mapper>
